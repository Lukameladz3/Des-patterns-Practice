{
    "name": "des-patterns-pracrice",
    "version": "1.0.0",
    "description": "Playwright + TypeScript test automation framework demonstrating multiple design patterns",
    "main": "index.js",
    "scripts": {
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:ui": "playwright test --ui",
        "test:debug": "playwright test --debug",
        "test:visual": "playwright test tests/visual.spec.ts",
        "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "playwright",
        "typescript",
        "design-patterns",
        "test-automation"
    ],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@reportportal/agent-js-playwright": "^5.3.2",
        "@types/node": "^25.0.3",
        "typescript": "^5.6.0"
    },
    "dependencies": {
        "dotenv": "^17.2.3",
        "mysql2": "^3.16.0"
    }
}
